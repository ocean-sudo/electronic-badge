# Explicit CLI options > process environment > repository-root .env > defaults.
# Comma-separated IPv4 listeners; empty means loopback only.
BADGE_HOSTS=127.0.0.1
# Comma-separated extra Host names, without protocol or port. Empty means none.
# Listener IPs, localhost and 127.0.0.1 remain allowed automatically.
BADGE_ALLOW_HOSTS=
BADGE_PORT=8765
# Empty auto-detects one supported Espressif USB device; set a local path if needed.
BADGE_SERIAL=
